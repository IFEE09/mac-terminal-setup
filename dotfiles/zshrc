export PATH="$HOME/.local/bin:$PATH"

# Tema visual: solo en la Terminal de Mac (las demás terminales quedan como vienen)
if [[ "$TERM_PROGRAM" == "Apple_Terminal" && -o interactive ]]; then
  BREW="${HOMEBREW_PREFIX:-/opt/homebrew}"

  # Instant prompt de Powerlevel10k
  if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
  fi

  # Colores del ls de Mac (mismo comando, solo color)
  export CLICOLOR=1
  export LSCOLORS=ExGxFxdaCxDaDahbadeche

  source "$BREW/share/powerlevel10k/powerlevel10k.zsh-theme"
  [[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

  # Sugerencias en gris y colores de sintaxis
  source "$BREW/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  source "$BREW/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"  # siempre al final
fi
